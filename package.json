{
  "name": "budget-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-cc": "tsx prisma/backfill-cc-payments.ts",
    "db:backfill-included": "tsx prisma/backfill-included-spending.ts",
    "db:backfill-groceries": "tsx prisma/backfill-grocery-merchants.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "plaid": "^47.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.10.1",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "supabase": "^2.122.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild": true,
    "workerd": true
  }
}
