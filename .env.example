# --- Database ---
# Local SQLite file. Swap for a hosted Postgres URL later to enable multi-machine sync.
DATABASE_URL="file:./dev.db"

# --- Plaid ---
# Get these free at https://dashboard.plaid.com/  (Team Settings > Keys)
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# sandbox | development | production
PLAID_ENV="sandbox"
# Comma-separated Plaid products
PLAID_PRODUCTS="transactions"
# Comma-separated country codes
PLAID_COUNTRY_CODES="US"

# --- Auth ---
# Shared password for the login page. Changing it logs everyone out.
APP_PASSWORD=""
